<Window x:Class="WinTaskbarMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:WinTaskbarMonitor.UI"
        mc:Ignorable="d"
        Title="Win11TaskbarMonitor"
        Icon="Resources/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        d:DataContext="{d:DesignInstance ui:MainWidgetViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Theme.TextSubtleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding FontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="SeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{Binding Theme.SeparatorBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,4,0" />
        </Style>

        <Style x:Key="MetricContainerStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,0,3,0" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.Placement" Value="Top" />
            <Setter Property="ToolTipService.VerticalOffset" Value="-6" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F51C1C1C" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#3CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7,10,7" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="4"
            BorderThickness="0"
            Background="Transparent"
            BorderBrush="Transparent"
            Padding="6,2,6,2"
            SnapsToDevicePixels="True">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh Rate">
                    <MenuItem Header="500 ms" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="500" />
                    <MenuItem Header="1 second" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="1000" />
                    <MenuItem Header="2 seconds" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="2000" />
                    <MenuItem Header="5 seconds" Command="{Binding SetRefreshIntervalCommand}" CommandParameter="5000" />
                </MenuItem>
                <MenuItem Header="Temperature Unit">
                    <MenuItem Header="Celsius (°C)" Command="{Binding SetTemperatureUnitCommand}" CommandParameter="Celsius" />
                    <MenuItem Header="Fahrenheit (°F)" Command="{Binding SetTemperatureUnitCommand}" CommandParameter="Fahrenheit" />
                </MenuItem>
                <MenuItem Header="Theme">
                    <MenuItem Header="Windows System" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                    <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}" FontWeight="SemiBold" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- CPU Load -->
            <StackPanel Style="{StaticResource MetricContainerStyle}"
                        Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding CpuTooltip}">
                <TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}" />
                <TextBlock Text="{Binding CpuValue}"
                           Foreground="{Binding CpuBrush}"
                           Style="{StaticResource MetricValueStyle}"
                           MinWidth="28"
                           TextAlignment="Center" />
            </StackPanel>

            <Rectangle Style="{StaticResource SeparatorStyle}"
                       Visibility="{Binding ShowCpuTemp, Converter={StaticResource BoolToVis}}" />

            <!-- CPU Temp -->
            <StackPanel Style="{StaticResource MetricContainerStyle}"
                        Visibility="{Binding ShowCpuTemp, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding CpuTempTooltip}">
                <TextBlock Text="CPU°" Style="{StaticResource MetricLabelStyle}" />
                <TextBlock Text="{Binding CpuTempValue}"
                           Foreground="{Binding CpuTempBrush}"
                           Style="{StaticResource MetricValueStyle}"
                           MinWidth="34"
                           TextAlignment="Center" />
            </StackPanel>

            <Rectangle Style="{StaticResource SeparatorStyle}"
                       Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}" />

            <!-- RAM Usage -->
            <StackPanel Style="{StaticResource MetricContainerStyle}"
                        Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding RamTooltip}">
                <TextBlock Text="RAM" Style="{StaticResource MetricLabelStyle}" />
                <TextBlock Text="{Binding RamValue}"
                           Foreground="{Binding RamBrush}"
                           Style="{StaticResource MetricValueStyle}"
                           MinWidth="30"
                           TextAlignment="Center" />
            </StackPanel>

            <Rectangle Style="{StaticResource SeparatorStyle}"
                       Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVis}}" />

            <!-- GPU Load -->
            <StackPanel Style="{StaticResource MetricContainerStyle}"
                        Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding GpuTooltip}">
                <TextBlock Text="GPU" Style="{StaticResource MetricLabelStyle}" />
                <TextBlock Text="{Binding GpuValue}"
                           Foreground="{Binding GpuBrush}"
                           Style="{StaticResource MetricValueStyle}"
                           MinWidth="28"
                           TextAlignment="Center" />
            </StackPanel>

            <Rectangle Style="{StaticResource SeparatorStyle}"
                       Visibility="{Binding ShowGpuTemp, Converter={StaticResource BoolToVis}}" />

            <!-- GPU Temp -->
            <StackPanel Style="{StaticResource MetricContainerStyle}"
                        Visibility="{Binding ShowGpuTemp, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding GpuTempTooltip}">
                <TextBlock Text="GPU°C" Style="{StaticResource MetricLabelStyle}" />
                <TextBlock Text="{Binding GpuTempValue}"
                           Foreground="{Binding GpuTempBrush}"
                           Style="{StaticResource MetricValueStyle}"
                           MinWidth="34"
                           TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
