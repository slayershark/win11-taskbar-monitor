<Window x:Class="WinTaskbarMonitor.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:WinTaskbarMonitor.UI"
        mc:Ignorable="d"
        Title="WinTaskbarMonitor Settings"
        Icon="../Resources/app.ico"
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        d:DataContext="{d:DesignInstance ui:SettingsViewModel}">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with Brand Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
            <Image Source="../Resources/app_32.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WinTaskbarMonitor" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Lightweight Windows 11 Taskbar System Monitor" Foreground="#888888" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Content Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group 1: Display Metrics -->
                <GroupBox Header="Monitored Metrics">
                    <StackPanel>
                        <CheckBox Content="CPU Utilisation (%)" IsChecked="{Binding ShowCpu}" />
                        <CheckBox Content="GPU Utilisation (%)" IsChecked="{Binding ShowGpu}" />
                        <CheckBox Content="CPU Temperature" IsChecked="{Binding ShowCpuTemp}" />
                        <CheckBox Content="GPU Temperature" IsChecked="{Binding ShowGpuTemp}" />
                        <CheckBox Content="RAM Utilisation" IsChecked="{Binding ShowRam}" />

                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="Monitored GPU:" VerticalAlignment="Center" Width="130" />
                            <ComboBox ItemsSource="{Binding GpuItems}"
                                      SelectedValue="{Binding SelectedGpuIndex}"
                                      SelectedValuePath="Index"
                                      DisplayMemberPath="DisplayName" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Group 2: Appearance -->
                <GroupBox Header="Appearance">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Theme:" VerticalAlignment="Center" Width="130" />
                            <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeMode}" />
                        </DockPanel>

                        <DockPanel>
                            <TextBlock Text="Temperature Unit:" VerticalAlignment="Center" Width="130" />
                            <ComboBox ItemsSource="{Binding TemperatureUnits}" SelectedItem="{Binding SelectedTemperatureUnit}" />
                        </DockPanel>

                        <DockPanel>
                            <TextBlock Text="Taskbar Alignment:" VerticalAlignment="Center" Width="130" />
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding SelectedAlignment}" />
                        </DockPanel>

                        <CheckBox Content="Compact Mode (Percentage-only for RAM)" IsChecked="{Binding CompactMode}" />

                        <DockPanel>
                            <TextBlock Text="Font Size:" VerticalAlignment="Center" Width="130" />
                            <Slider Minimum="9.5" Maximum="14.0" Value="{Binding FontSize}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Group 3: Behavior -->
                <GroupBox Header="Behavior">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Refresh Interval:" VerticalAlignment="Center" Width="130" />
                            <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshIntervalMs}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding StringFormat="{}{0} ms" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#33888888" Padding="0,12,0,0" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Restore Defaults"
                        Command="{Binding ResetDefaultsCommand}"
                        Padding="12,6"
                        DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Save &amp; Apply"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            Padding="16,6"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            Command="{Binding CloseCommand}"
                            IsCancel="True"
                            Padding="16,6" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
